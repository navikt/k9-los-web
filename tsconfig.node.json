{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"types": ["node"],
		"skipLibCheck": true,
		"moduleResolution": "NodeNext",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true
	},
	"include": ["vite.config.ts"]
}
